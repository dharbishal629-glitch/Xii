{
    "compilerOptions": {
      "target": "ES2022",
      "module": "ESNext",
      "moduleResolution": "Bundler",
      "allowSyntheticDefaultImports": true,
      "esModuleInterop": true,
      "strict": false,
      "skipLibCheck": true,
      "isolatedModules": true,
      "noEmitOnError": false,
      "typeRoots": [
        "../artifacts/api-server/node_modules/@types",
        "../node_modules/@types"
      ],
      "types": ["node"]
    },
    "include": ["."]
  }
  